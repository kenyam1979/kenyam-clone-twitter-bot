# Required for drafting tweets with OpenAI via LangChain.
OPENAI_API_KEY=

# Optional. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# Optional. Enable LangSmith tracing for LangChain runs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=twitter-bot

# Optional X API credentials.
# X_BEARER_TOKEN is app-only and useful for read-only X API calls.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_BEARER_TOKEN=

# Required only when running with --post.
# X requires user-context credentials to create posts.
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
